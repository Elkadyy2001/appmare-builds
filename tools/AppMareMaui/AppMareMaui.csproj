<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
				<TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst;net11.0-browser</TargetFrameworks>

		<!-- <TargetFrameworks>net11.0-browser</TargetFrameworks> -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PackageId>AppMareMaui</PackageId>
		<Version>1.0.5</Version>
		<Authors>AppMare</Authors>
		<Description>AppMare Package</Description>
		<PackageTags>AppMare;Uno;library</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-browser'">
		<PackageReference Include="Avalonia.Browser" Version="12.0.3" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="GuerrillaNtp" Version="3.1.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="*" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="*" />
		<PackageReference Include="FireSharp" Version="2.0.4" />
		<PackageReference Include="FirebaseAuthentication.net" Version="4.1.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="*" />
		<PackageReference Include="Sep" Version="0.11.2" />
		<PackageReference Include="Plugin.InAppBilling.Extended" Version="*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-ios'">
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="*" />
		<PackageReference Include="Plugin.MauiMTAdmob" Version="2.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-browser'">
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-android'">
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="*" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="*" />
		<PackageReference Include="Plugin.MauiMTAdmob" Version="1.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="*" />
		<PackageReference Include="CommunityToolkit.Maui.Maps" Version="*" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Platforms\MacCatalyst\" />
	  <None Remove="Platforms\iOS\" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Platforms\MacCatalyst\" />
	  <Folder Include="Platforms\iOS\" />
	</ItemGroup>
</Project>
