<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMare_Maui.PopUps.PaypalPopup"
             Title="PaypalPopup">
  <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>    <!-- Header with buttons -->
            <RowDefinition Height="*"/>     <!-- WebView -->
        </Grid.RowDefinitions>

        <!-- Header with navigation buttons -->
        <Border Grid.Row="0" 
                BackgroundColor="#0070BA"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>  <!-- Close -->
                    <ColumnDefinition Width="50"/>  <!-- Back -->
                    <ColumnDefinition Width="50"/>  <!-- Forward -->
                    <ColumnDefinition Width="50"/>  <!-- Reload -->
                    <ColumnDefinition Width="*"/>   <!-- Title/URL -->
                </Grid.ColumnDefinitions>

                <!-- Close Button -->
                <Button Grid.Column="0"
                        x:Name="CloseButton"
                        Text="close"
                        FontFamily="MaterialIconRegular"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="CloseButton_Clicked"
                        ToolTipProperties.Text="Close"/>

                <!-- Back Button -->
                <Button Grid.Column="1"
                        x:Name="BackButton"
                        Text="arrow_back" 
                        FontFamily="MaterialIconRegular"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        IsEnabled="False"
                        Clicked="BackButton_Clicked"
                        ToolTipProperties.Text="Back"/>

                <!-- Forward Button -->
                <Button Grid.Column="2"
                        x:Name="ForwardButton"
                        Text="arrow_forward"
                        FontFamily="MaterialIconRegular"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        IsEnabled="False"
                        Clicked="ForwardButton_Clicked"
                        ToolTipProperties.Text="Forward"/>

                <!-- Reload Button -->
                <Button Grid.Column="3"
                        x:Name="ReloadButton"
                        Text="refresh"
                        FontFamily="MaterialIconRegular"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="ReloadButton_Clicked"
                        ToolTipProperties.Text="Reload"/>

                <!-- Title/URL Display -->
                <StackLayout Grid.Column="4" 
                             VerticalOptions="Center"
                             Margin="10,0">
                    <Label x:Name="PageTitleLabel"
                           Text="PayPal Checkout"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"/>
                    <Label x:Name="PageUrlLabel"
                           Text="Loading..."
                           TextColor="LightGray"
                           FontSize="12"
                           HorizontalOptions="Start"
                           LineBreakMode="TailTruncation"/>
                </StackLayout>

            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          x:Name="LoadingIndicator"
                          IsVisible="False"
                          IsRunning="False"
                          Color="#0070BA"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          HeightRequest="50"
                          WidthRequest="50"/>

        <!-- WebView -->
        <WebView Grid.Row="1"
                 x:Name="PayPalWebView"
                 BackgroundColor="White"
           
                 Navigated="PayPalWebView_Navigated"/>

        <!-- Error Message (Hidden by default) -->
        <StackLayout Grid.Row="1"
                     x:Name="ErrorLayout"
                     IsVisible="False"
                     BackgroundColor="White"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Padding="20">
            
            <Label Text="error_outline"
                   FontFamily="MaterialIconRegular"
                   FontSize="48"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>
            
            <Label Text="Failed to load PayPal"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,10"/>
            
            <Label x:Name="ErrorMessageLabel"
                   Text="Please check your internet connection"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            
            <Button Text="Try Again"
                    BackgroundColor="#0070BA"
                    TextColor="White"
                    Margin="0,20"
                  
                    HorizontalOptions="Center"/>
            
        </StackLayout>

        <!-- Status Bar at bottom (optional) -->
        <Border Grid.Row="1"
                x:Name="StatusBorder"
                BackgroundColor="LightGray"
                StrokeThickness="0"
                VerticalOptions="End"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            
            <Label x:Name="StatusLabel"
                   Text="Connecting to PayPal..."
                   FontSize="12"
                   TextColor="DarkGray"
                   Padding="10,5"
                   HorizontalOptions="Start"/>
            
        </Border>

    </Grid>
</ContentPage>